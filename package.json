{
  "name": "webgpu-grass",
  "private": true,
  "version": "0.0.0",
  "description": "Grass for three.js on WebGPU, written in TSL, with a lab to set it in.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --open /lab/",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/boundary.test.mjs test/placement.test.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  }
}
